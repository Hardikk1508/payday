# Groq -- used by the diagnose node and outreach copy generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# MongoDB Atlas -- decision ledger and outcome history
MONGODB_URI=
MONGODB_DB=payday

# Resend -- actually sends the generated outreach email (POST /send-outreach-email)
# Without a verified domain, Resend restricts sends to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Payday <onboarding@resend.dev>

# Redis -- retry scheduler queue
REDIS_URL=redis://localhost:6379/0

# Simulation defaults
PAYDAY_SEED=42
PAYDAY_OUTCOME_SEED=20260905
PAYDAY_HORIZON_DAYS=30
